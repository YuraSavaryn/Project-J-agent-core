# ────────────────────────────────────────────────
# agent-core — environment variables template
# Copy to .env and fill in your values
# ────────────────────────────────────────────────

# Application
APP_ENV=development           # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── LLM Providers ────────────────────────────────
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=llama-3.1-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3.5-sonnet

# Primary LLM provider: groq | openrouter
LLM_PRIMARY_PROVIDER=groq

# ── Redis ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL_SECONDS=86400      # 24 hours

# ── PostgreSQL ────────────────────────────────────
POSTGRES_DSN=postgresql+asyncpg://agent:secret@localhost:5432/agentcore

# ── ChromaDB ─────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=agent_knowledge

# ── Embeddings ────────────────────────────────────
# Provider: local | gemini
EMBEDDING_PROVIDER=local
EMBEDDING_WORKER_URL=http://localhost:8002

GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ── RAG ───────────────────────────────────────────
RAG_TOP_K=5
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64

