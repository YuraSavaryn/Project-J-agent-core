# ────────────────────────────────────────────────
# agent-core — environment variables template
# Copy to .env and fill in your values
# ────────────────────────────────────────────────

# Application
APP_ENV=development           # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── LLM Providers ────────────────────────────────
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=llama-3.1-8b-instant

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openrouter/free

# Primary LLM provider: groq | openrouter
LLM_PRIMARY_PROVIDER=groq
LLM_REQUEST_TIMEOUT_SECONDS=30.0

# ── Redis ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL_SECONDS=86400      # 24 hours

# ── PostgreSQL ────────────────────────────────────
POSTGRES_DSN=postgresql+asyncpg://agent:secret@localhost:5432/agentcore

# ── ChromaDB ─────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
# Single shared collection for all knowledge (step 9 convention)
CHROMA_COLLECTION=ngo_knowledge_base
# bge-m3 / e5 vector dimension and distance function
CHROMA_VECTOR_DIM=384
CHROMA_DISTANCE_FN=cosine

# ── Embeddings ────────────────────────────────────
# Provider: local | gemini
EMBEDDING_PROVIDER=local
EMBEDDING_WORKER_URL=http://localhost:8002

GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ── RAG ───────────────────────────────────────────
RAG_TOP_K=5
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64

